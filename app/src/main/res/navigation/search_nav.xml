<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/search_nav"
    app:startDestination="@id/searchFragment">

    <fragment
        android:id="@+id/searchFragment"
        android:name="io.github.he11pme.movieapp.fragments.search.SearchFragment"
        android:label="fragment_search"
        tools:layout="@layout/fragment_search" >
        <action
            android:id="@+id/navigateFromSearchFragmentToNavigation"
            app:destination="@id/detail_nav" >
            <argument
                android:name="movieId"
                android:defaultValue="-1"
                app:argType="integer" />
            <argument
                android:name="transitionName"
                android:defaultValue=""
                app:argType="string" />
            <argument
                android:name="source"
                app:argType="io.github.he11pme.movieapp.fragments.detail.DetailInfoFragment$Companion$Source"
                android:defaultValue="CONTENT" />
        </action>
    </fragment>

    <include app:graph="@navigation/detail_nav"/>

</navigation>