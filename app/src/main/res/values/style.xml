<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Base.Widget.MovieApp.Toolbar" parent="Widget.MaterialComponents.Toolbar.Primary">
        <item name="materialThemeOverlay">@style/ThemeOverlay.MovieApp.Toolbar</item>
    </style>
    <style name="Widget.MovieApp.Toolbar" parent="Base.Widget.MovieApp.Toolbar"/>

    <style name="Base.Widget.MovieApp.SearchBar" parent="Widget.Material3.SearchBar">
        <item name="materialThemeOverlay">@style/ThemeOverlay.MovieApp.SearchBar</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.M3.Sys.Shape.Corner.Small</item>
    </style>
    <style name="Widget.MovieApp.SearchBar" parent="Base.Widget.MovieApp.SearchBar"/>

    <style name="Base.Widget.MovieApp.SearchView" parent="Widget.Material3.SearchView">
        <item name="materialThemeOverlay">@style/ThemeOverlay.MovieApp.SearchView</item>
    </style>
    <style name="Widget.MovieApp.SearchView" parent="Base.Widget.MovieApp.SearchView"/>

    <style name="Base.Widget.MovieApp.BottomAppBar" parent="Widget.Material3.BottomAppBar.Legacy">
        <item name="materialThemeOverlay">@style/ThemeOverlay.MovieApp.BottomAppBar</item>
    </style>
    <style name="Widget.MovieApp.BottomAppBar" parent="Base.Widget.MovieApp.BottomAppBar"/>

    <style name="Base.Widget.MovieApp.BottomNavigationView" parent="Widget.Material3.BottomNavigationView">
        <item name="itemGravity">center</item>
        <item name="materialThemeOverlay">@style/ThemeOverlay.MovieApp.BottomNavigationView</item>
    </style>
    <style name="Widget.MovieApp.BottomNavigationView" parent="Base.Widget.MovieApp.BottomNavigationView"/>

    <style name="Base.Widget.MovieApp.Poster" parent="">
        <item name="layout_constraintDimensionRatio">0.667</item>
    </style>
    <style name="Widget.MovieApp.Poster" parent="Base.Widget.MovieApp.Poster"/>

    <style name="Base.Widget.MovieApp.Vote" parent="">
        <item name="android:background">@color/background_vote_view</item>
    </style>
    <style name="Widget.MovieApp.Vote.Medium" parent="Base.Widget.MovieApp.Vote">
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingTop">1dp</item>
        <item name="android:paddingEnd">4dp</item>
        <item name="android:paddingBottom">1dp</item>
        <item name="android:textAppearance">@style/TextAppearance.MovieApp.VoteMedium</item>
    </style>

    <style name="Base.Widget.MovieApp.TitleCard" parent=""/>
    <style name="Widget.MovieApp.TitleCard" parent="Base.Widget.MovieApp.TitleCard">
        <item name="android:textAppearance">@style/TextAppearance.MovieApp.TitleCardMedium</item>
    </style>

</resources>