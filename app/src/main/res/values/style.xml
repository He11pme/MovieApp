<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Base.Widget.MovieApp.Toolbar" parent="Widget.MaterialComponents.Toolbar.Primary">
        <item name="materialThemeOverlay">@style/ThemeOverlay.MovieApp.Toolbar</item>
    </style>

    <style name="Widget.MovieApp.Toolbar" parent="Base.Widget.MovieApp.Toolbar" />

    <style name="Base.Widget.MovieApp.SearchBar" parent="Widget.Material3.SearchBar">
        <item name="materialThemeOverlay">@style/ThemeOverlay.MovieApp.SearchBar</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.M3.Sys.Shape.Corner.Small</item>
    </style>

    <style name="Widget.MovieApp.SearchBar" parent="Base.Widget.MovieApp.SearchBar" />

    <style name="Base.Widget.MovieApp.SearchView" parent="Widget.Material3.SearchView">
        <item name="materialThemeOverlay">@style/ThemeOverlay.MovieApp.SearchView</item>
    </style>

    <style name="Widget.MovieApp.SearchView" parent="Base.Widget.MovieApp.SearchView" />

    <style name="Base.Widget.MovieApp.BottomAppBar" parent="Widget.Material3.BottomAppBar.Legacy">
        <item name="materialThemeOverlay">@style/ThemeOverlay.MovieApp.BottomAppBar</item>
    </style>

    <style name="Widget.MovieApp.BottomAppBar" parent="Base.Widget.MovieApp.BottomAppBar" />

    <style name="Base.Widget.MovieApp.BottomNavigationView" parent="Widget.Material3.BottomNavigationView">
        <item name="itemGravity">center</item>
        <item name="materialThemeOverlay">@style/ThemeOverlay.MovieApp.BottomNavigationView</item>
    </style>

    <style name="Widget.MovieApp.BottomNavigationView" parent="Base.Widget.MovieApp.BottomNavigationView" />

    <style name="Base.Widget.MovieApp.Poster" parent="">
        <item name="layout_constraintDimensionRatio">0.667</item>
    </style>

    <style name="Widget.MovieApp.Poster" parent="Base.Widget.MovieApp.Poster" />

    <style name="Base.Widget.MovieApp.Vote" parent="">
        <item name="android:background">@color/background_vote_view</item>
    </style>

    <style name="Widget.MovieApp.Vote.Medium" parent="Base.Widget.MovieApp.Vote">
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingTop">1dp</item>
        <item name="android:paddingEnd">4dp</item>
        <item name="android:paddingBottom">1dp</item>
        <item name="android:textAppearance">@style/TextAppearance.MovieApp.VoteMedium</item>
    </style>

    <style name="Base.Widget.MovieApp.TitleCard" parent="" />

    <style name="Widget.MovieApp.TitleCard" parent="Base.Widget.MovieApp.TitleCard">
        <item name="android:textAppearance">@style/TextAppearance.MovieApp.TitleCardMedium</item>
    </style>

    <style name="Widget.MovieApp.TitleCard.Fullwidth" parent="Base.Widget.MovieApp.TitleCard">
        <item name="android:textAppearance">@style/TextAppearance.MovieApp.Title.Large.Fullwidth
        </item>
    </style>

    <style name="Base.Widget.MovieApp.TitleSelection" parent="">
        <item name="android:textAppearance">@style/TextAppearance.MovieApp.TitleSelection</item>
        <item name="android:lines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="Widget.MovieApp.TitleSelection" parent="Base.Widget.MovieApp.TitleSelection" />

    <style name="Base.Widget.MovieApp.AccentText" parent="">
        <item name="android:textAppearance">@style/TextAppearance.MovieApp.AccentText</item>
    </style>

    <style name="Widget.MovieApp.AccentText" parent="Base.Widget.MovieApp.AccentText" />

    <style name="Widget.MovieApp.AccentText.Colorless">
        <item name="android:textAppearance">@style/TextAppearance.MovieApp.AccentText.Colorless
        </item>
    </style>

    <style name="Widget.MovieApp.IconButton.Filled" parent="Widget.Material3.Button.IconButton.Filled">

        <item name="iconGravity">textStart</item>
        <item name="backgroundTint">@color/foreground_variant</item>
        <item name="iconTint">@color/on_foreground</item>

    </style>

    <style name="Widget.MovieApp.IconButton.Filled.Medium">

        <item name="android:layout_width">56dp</item>
        <item name="android:layout_height">56dp</item>
        <item name="iconSize">24dp</item>

    </style>

    <style name="Widget.MovieApp.IconButton.Filled.Medium.Toggle">

        <item name="backgroundTint">@color/toggle_button_background</item>
        <item name="iconTint">@color/toggle_button_icon</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>

    </style>

    <style name="Widget.MovieApp.ToggleButton.SwitchTheme" parent="Widget.Material3.MaterialButtonToggleGroup">

        <item name="android:spacing">2dp</item>
        <item name="android:layout_marginEnd">10dp</item>
        <item name="android:paddingTop">2dp</item>
        <item name="android:paddingBottom">2dp</item>

    </style>

    <style name="Widget.MovieApp.IconButton.Filled.Medium.Elevated">
        <item name="android:elevation">4dp</item>
    </style>

    <style name="Base.Widget.MovieApp.TitleHeadline" parent="">
        <item name="android:textAppearance">@style/TextAppearance.MovieApp.HeadlineText</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="Widget.MovieApp.TitleHeadline" parent="Base.Widget.MovieApp.TitleHeadline" />

    <style name="Base.Widget.MovieApp.Tagline" parent="">
        <item name="android:textAppearance">@style/TextAppearance.MovieApp.Tagline</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="Widget.MovieApp.Settings.Headline" parent="Widget.AppCompat.TextView">
        <item name="android:textAppearance">@style/TextAppearance.MovieApp.Settings.Headline</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:background">@color/container_on_foreground_variant</item>
        <item name="android:padding">10dp</item>
    </style>

    <style name="Widget.MovieApp.Tagline" parent="Base.Widget.MovieApp.Tagline" />

    <style name="Base.Widget.MovieApp.Parameters" parent="">
        <item name="android:textAppearance">@style/TextAppearance.MovieApp.Parameters</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="Widget.MovieApp.Parameters" parent="Base.Widget.MovieApp.Parameters" />

    <style name="Widget.MovieApp.Parameters.Fullwidth">
        <item name="android:gravity">start</item>
        <item name="android:lines">1</item>
    </style>

    <style name="Widget.MovieApp.Overview" parent="">

        <item name="android:ellipsize">end</item>
        <item name="android:maxLines">3</item>
        <item name="android:justificationMode">inter_word</item>
        <item name="android:textAppearance">@style/TextAppearance.Material3.BodySmall</item>

    </style>

    <style name="Widget.MovieApp.SplashLottieAnimation" parent="">

        <item name="android:layout_width">192dp</item>
        <item name="android:layout_height">192dp</item>
        <item name="android:layout_gravity">center</item>
        <!--    Scale values are adjusted to match the SplashScreen icon size   -->
        <item name="android:scaleX">1.5</item>
        <item name="android:scaleY">1.5</item>
        <!--    Animation size does not fully match the SplashScreen icon,
                so the element is shifted by 8dp for visual alignment   -->
        <item name="android:translationY">-8dp</item>

    </style>


</resources>