        <item name="colorPrimary">@color/background_toolbar</item>
        <item name="colorOnPrimary">@color/menu_toolbar</item>
    </style>

    <style name="Base.ThemeOverlay.MovieApp.SearchBar" parent="ThemeOverlay.Material3.Search"/>
