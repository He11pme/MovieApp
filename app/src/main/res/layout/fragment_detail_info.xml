<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@color/background">

    <data>

        <variable
            name="viewModel"
            type="io.github.he11pme.movieapp.fragments.detail.DetailInfoViewModel" />

    </data>

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/detailInfoMain"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".fragments.detail.DetailInfoFragment">

        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/appBarDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:elevation="0dp">

            <com.google.android.material.appbar.CollapsingToolbarLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_scrollFlags="scroll|exitUntilCollapsed"
                app:titleEnabled="false">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/posterDetail"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        app:layout_collapseMode="parallax"
                        app:layout_collapseParallaxMultiplier="0.7"
                        app:layout_constraintDimensionRatio="0.667"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        tools:src="@drawable/tools_poster" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/favoriteBtn"
                        style="@style/Widget.MovieApp.IconButton.Filled.Medium.Elevated"
                        android:layout_marginBottom="10dp"
                        android:onClickListener="@{() -> viewModel.onFavoriteBtnClicked()}"
                        app:icon="@drawable/ic_favorite"
                        app:layout_collapseMode="parallax"
                        app:layout_constraintBottom_toBottomOf="@+id/posterDetail"
                        app:layout_constraintEnd_toStartOf="@+id/downloadBtn"
                        app:layout_constraintHorizontal_bias="0.5"
                        app:layout_constraintHorizontal_chainStyle="packed"
                        app:layout_constraintStart_toStartOf="parent" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/downloadBtn"
                        style="@style/Widget.MovieApp.IconButton.Filled.Medium.Elevated"
                        android:layout_marginStart="30dp"
                        android:layout_marginEnd="30dp"
                        android:onClickListener="@{() -> viewModel.onDownloadBtnClicked()}"
                        app:icon="@drawable/ic_download"
                        app:layout_collapseMode="parallax"
                        app:layout_constraintBottom_toBottomOf="@+id/favoriteBtn"
                        app:layout_constraintEnd_toStartOf="@+id/shareBtn"
                        app:layout_constraintHorizontal_bias="0.5"
                        app:layout_constraintStart_toEndOf="@+id/favoriteBtn"
                        app:layout_constraintTop_toTopOf="@+id/favoriteBtn" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/shareBtn"
                        style="@style/Widget.MovieApp.IconButton.Filled.Medium.Elevated"
                        android:onClickListener="@{() -> viewModel.onShareBtnClicked()}"
                        app:icon="@drawable/ic_share"
                        app:layout_collapseMode="parallax"
                        app:layout_constraintBottom_toBottomOf="@+id/favoriteBtn"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintHorizontal_bias="0.5"
                        app:layout_constraintStart_toEndOf="@+id/downloadBtn"
                        app:layout_constraintTop_toTopOf="@+id/favoriteBtn" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/backBtn"
                        style="@style/Widget.MovieApp.IconButton.Filled.Medium.Elevated"
                        android:layout_marginStart="10dp"
                        android:layout_marginTop="75dp"
                        android:elevation="8dp"
                        app:icon="@drawable/ic_arrow_back"
                        app:layout_collapseMode="parallax"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        tools:alpha="1" />

                    <!--    In the future, I will switch to customView  -->
                    <TextView
                        android:id="@+id/voteText"
                        style="@style/Widget.MovieApp.Vote.Medium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="10dp"
                        android:textSize="16sp"
                        app:layout_collapseMode="parallax"
                        app:layout_constraintBottom_toBottomOf="@+id/backBtn"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@+id/backBtn"
                        tools:text="TMDb: 7.8" />

                    <ImageView
                        android:id="@+id/bottom_background"
                        android:layout_width="0dp"
                        android:layout_height="400dp"
                        android:src="@drawable/bottom_background_gradient_poster"
                        app:layout_collapseMode="parallax"
                        app:layout_collapseParallaxMultiplier="0.9"
                        app:layout_constraintBottom_toBottomOf="@+id/posterDetail"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />

                    <ImageView
                        android:id="@+id/header_background"
                        android:layout_width="0dp"
                        android:layout_height="75dp"
                        android:src="@drawable/top_background_gradient_poster"
                        app:layout_collapseMode="parallax"
                        app:layout_collapseParallaxMultiplier="0.9"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintHorizontal_bias="0.0"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="@+id/posterDetail" />

                    <TextView
                        android:id="@+id/titleText"
                        style="@style/Widget.MovieApp.TitleHeadline"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        app:layout_collapseMode="parallax"
                        app:layout_collapseParallaxMultiplier="0.8"
                        app:layout_constraintBottom_toTopOf="@+id/taglineText"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        tools:text="FIGHT CLUB" />

                    <TextView
                        android:id="@+id/taglineText"
                        style="@style/Widget.MovieApp.Tagline"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="20dp"
                        android:layout_marginEnd="20dp"
                        android:layout_marginBottom="5dp"
                        app:layout_collapseMode="parallax"
                        app:layout_constraintBottom_toTopOf="@+id/parametersText"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        tools:text="Mischief. Mayhem. Soap." />

                    <TextView
                        android:id="@+id/parametersText"
                        style="@style/Base.Widget.MovieApp.Parameters"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="20dp"
                        app:layout_collapseMode="parallax"
                        app:layout_constraintBottom_toTopOf="@+id/downloadBtn"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        tools:text="1999 • Drama • Thriller • Comedy\nUnited States of America • 139 min" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <com.google.android.material.appbar.MaterialToolbar
                    android:id="@+id/toolbarDetail"
                    android:layout_width="match_parent"
                    android:layout_height="?attr/actionBarSize"
                    android:visibility="invisible"
                    app:layout_collapseMode="pin" />

            </com.google.android.material.appbar.CollapsingToolbarLayout>

        </com.google.android.material.appbar.AppBarLayout>

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">

            <TextView
                android:id="@+id/overviewText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="10dp"
                android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                android:textColor="@color/on_background"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/posterDetail"
                tools:text="A ticking-time-bomb insomniac and a slippery soap salesman channel primal male aggression into a shocking new form of therapy. Their concept catches on, with underground fight clubs forming in every town, until an eccentric gets in the way and ignites an out-of-control spiral toward oblivion." />

        </androidx.core.widget.NestedScrollView>

    </androidx.coordinatorlayout.widget.CoordinatorLayout>
</layout>