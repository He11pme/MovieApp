<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/background"
    android:paddingStart="5dp"
    android:paddingEnd="10dp">

    <ImageView
        android:id="@+id/posterMovieItem"
        style="@style/Widget.MovieApp.Poster"
        android:layout_width="80dp"
        android:layout_height="0dp"
        android:layout_marginTop="5dp"
        android:contentDescription="@string/poster"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:srcCompat="@drawable/tools_poster" />

    <TextView
        android:id="@+id/titleMovieItem"
        style="@style/Widget.MovieApp.TitleCard.Fullwidth"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="5dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/posterMovieItem"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="Fight club" />

    <TextView
        android:id="@+id/parametersMovieItem"
        style="@style/Widget.MovieApp.Parameters.Fullwidth"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/titleMovieItem"
        app:layout_constraintTop_toBottomOf="@+id/titleMovieItem"
        tools:text="Drama • Thriller • Comedy • 139 min" />

    <TextView
        android:id="@+id/overviewMovieItem"
        style="@style/Widget.MovieApp.Overview"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/titleMovieItem"
        app:layout_constraintTop_toBottomOf="@+id/parametersMovieItem"
        tools:text="A ticking-time-bomb insomniac and a slippery soap salesman channel primal male aggression into a shocking new form of therapy. Their concept catches on, with underground fight clubs forming in every town, until an eccentric gets in the way and ignites an out-of-control spiral toward oblivion." />

    <TextView
        android:id="@+id/voteMovieItem"
        style="@style/Widget.MovieApp.AccentText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        app:layout_constraintStart_toStartOf="@+id/titleMovieItem"
        app:layout_constraintTop_toBottomOf="@+id/overviewMovieItem"
        tools:text="TMDb: 7.8" />

</androidx.constraintlayout.widget.ConstraintLayout>