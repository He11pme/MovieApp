<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <import type="io.github.he11pme.movieapp.view.model.ThemeMode" />

        <variable
            name="viewModel"
            type="io.github.he11pme.movieapp.view.fragments.settings.SettingsViewModel" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".view.fragments.settings.SettingsFragment">

        <TextView
            android:id="@+id/textView"
            style="@style/Widget.MovieApp.Settings.Headline"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:text="@string/application_theme"
            app:layout_constraintBottom_toBottomOf="@+id/toggleThemeMode"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/toggleThemeMode" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/toggleThemeMode"
            style="@style/Widget.MovieApp.ToggleButton.SwitchTheme"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="@+id/textView"
            app:layout_constraintTop_toTopOf="parent"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/toggleButtonLight"
                style="@style/Widget.MovieApp.IconButton.Filled.Medium.Toggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked='@{viewModel.defaultTheme == ThemeMode.LIGHT.nightMode}'
                app:icon="@drawable/ic_mode_light" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/toggleButtonSystem"
                style="@style/Widget.MovieApp.IconButton.Filled.Medium.Toggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked='@{viewModel.defaultTheme == ThemeMode.SYSTEM.nightMode}'
                app:icon="@drawable/ic_mode_system" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/toggleButtonNight"
                style="@style/Widget.MovieApp.IconButton.Filled.Medium.Toggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked='@{viewModel.defaultTheme == ThemeMode.DARK.nightMode}'
                app:icon="@drawable/ic_mode_night" />

        </com.google.android.material.button.MaterialButtonToggleGroup>


    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>